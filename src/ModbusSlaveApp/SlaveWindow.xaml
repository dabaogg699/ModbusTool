<Window x:Class="ModbusSlaveApp.SlaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ModbusTool.App.Views;assembly=ModbusTool"
        xmlns:controls="clr-namespace:ModbusTool.App.Controls;assembly=ModbusTool"
        Title="ModbusSlave - Modbus 从站仿真工具" Height="880" Width="1380" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Closing="OnClosing" Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="&#xE897;" Width="30" Padding="0" Click="OnHelpClick" Margin="0,0,4,0"
                            Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFontFamily}"
                            ToolTip="查看监听、数据区、仿真与故障注入说明" />
                    <Button Content="&#xE946;" Width="30" Padding="0" Click="OnAboutClick" Margin="0,0,6,0"
                            Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFontFamily}"
                            ToolTip="关于 ModbusSlave" />
                    <controls:ThemeSelector VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ModbusSlave" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderTextBrush}" />
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.7" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="从站" Foreground="{DynamicResource OnAccentBrush}" FontSize="10" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="Modbus 从站仿真工具" FontSize="10" Foreground="{DynamicResource NavTextBrush}" Opacity="0.7" />
                            <TextBlock Text="{Binding Text, ElementName=VersionText}" FontSize="10" Margin="0,3,0,0"
                                       Foreground="{DynamicResource NavTextBrush}" Opacity="0.55" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="从站功能" FontSize="11" Foreground="{DynamicResource NavTextBrush}" Opacity="0.65" Margin="18,2,0,6" />
                        <RadioButton x:Name="NavSlave" Content="从站仿真" Tag="&#xE70F;" TabIndex="0" GroupName="SlaveNav"
                                     Style="{StaticResource NavItemStyle}" IsChecked="True" Checked="OnNavChecked" />
                        <RadioButton Content="报文监视器" Tag="&#xE72D;" TabIndex="1" GroupName="SlaveNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                        <RadioButton Content="日志查看" Tag="&#xE7C3;" TabIndex="2" GroupName="SlaveNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource MainContentBrush}" Padding="10">
                <views:SlaveView x:Name="SlaveViewControl" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="RunStatusText" DockPanel.Dock="Left" Text="监听：已停止" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="0,0,18,0" />
                <TextBlock x:Name="PacketStatusText" DockPanel.Dock="Right" Text="报文：0" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="18,0,0,0" />
                <TextBlock x:Name="ActivityStatusText" Text="会话：0" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

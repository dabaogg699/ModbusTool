<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#020617</Color>
    <Color x:Key="PanelColor">#0F172A</Color>
    <Color x:Key="PanelAltColor">#111C31</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="TextColor">#E2E8F0</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="InputBackgroundColor">#111C31</Color>
    <Color x:Key="SelectionColor">#1E3A5F</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />

    <Color x:Key="StatusFreshColor">#34D399</Color>
    <Color x:Key="StatusStaleColor">#94A3B8</Color>
    <Color x:Key="StatusErrorColor">#F87171</Color>
    <Color x:Key="StatusUnknownColor">#64748B</Color>
    <Color x:Key="StatusFreshBackgroundColor">#0E2A22</Color>
    <Color x:Key="StatusStaleBackgroundColor">#16202F</Color>
    <Color x:Key="StatusErrorBackgroundColor">#2C1618</Color>
    <Color x:Key="StatusUnknownBackgroundColor">#111C31</Color>
    <Color x:Key="PacketSentColor">#60A5FA</Color>
    <Color x:Key="PacketReceivedColor">#34D399</Color>
    <Color x:Key="PacketErrorColor">#F87171</Color>
    <Color x:Key="PacketExceptionColor">#FDBA74</Color>
    <Color x:Key="PacketCrcMalformedColor">#FBBF24</Color>

    <SolidColorBrush x:Key="StatusFreshBrush" Color="{StaticResource StatusFreshColor}" />
    <SolidColorBrush x:Key="StatusStaleBrush" Color="{StaticResource StatusStaleColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusUnknownBrush" Color="{StaticResource StatusUnknownColor}" />
    <SolidColorBrush x:Key="StatusFreshBackgroundBrush" Color="{StaticResource StatusFreshBackgroundColor}" />
    <SolidColorBrush x:Key="StatusStaleBackgroundBrush" Color="{StaticResource StatusStaleBackgroundColor}" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="{StaticResource StatusErrorBackgroundColor}" />
    <SolidColorBrush x:Key="StatusUnknownBackgroundBrush" Color="{StaticResource StatusUnknownBackgroundColor}" />
    <SolidColorBrush x:Key="PacketSentBrush" Color="{StaticResource PacketSentColor}" />
    <SolidColorBrush x:Key="PacketReceivedBrush" Color="{StaticResource PacketReceivedColor}" />
    <SolidColorBrush x:Key="PacketErrorBrush" Color="{StaticResource PacketErrorColor}" />
    <SolidColorBrush x:Key="PacketExceptionBrush" Color="{StaticResource PacketExceptionColor}" />
    <SolidColorBrush x:Key="PacketCrcMalformedBrush" Color="{StaticResource PacketCrcMalformedColor}" />

    <SolidColorBrush x:Key="HeaderBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MainContentBrush" Color="#020617" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GroupHeaderBrush" Color="#111C31" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#F3F4F6" />
</ResourceDictionary>

<UserControl x:Class="ModbusTool.App.Controls.ThemeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" ToolTip="切换浅色、深色、工业蓝或深灰工业主题">
        <TextBlock Text="🎨" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"
                   Foreground="{DynamicResource HeaderTextBrush}" />
        <ComboBox x:Name="ThemeBox" Width="92" MinHeight="28" Margin="0,0,4,0" DisplayMemberPath="DisplayName"
                  SelectionChanged="OnThemeSelectionChanged" />
        <Button Content="⋯" Width="30" Padding="0" Style="{StaticResource IconButton}" ToolTip="导入或导出主题" Click="OnMoreClick">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="导入主题..." Click="OnImportThemeClick" />
                    <MenuItem Header="导出当前主题..." Click="OnExportThemeClick" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <TextBlock x:Name="ThemeNameText" Text="浅色" Visibility="Collapsed" />
    </StackPanel>
</UserControl>

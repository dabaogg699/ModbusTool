<UserControl x:Class="ModbusTool.App.Controls.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModbusTool.App.Controls"
             MinHeight="96" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="460" Margin="16">
        <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                   FontFamily="{StaticResource IconFontFamily}" FontSize="24" Margin="0,0,12,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Opacity="0.7" />
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=local:EmptyStateControl}}"
                       FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>

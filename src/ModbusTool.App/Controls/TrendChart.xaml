<UserControl x:Class="ModbusTool.App.Controls.TrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:ModbusTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="导出历史 CSV…" MinWidth="104" Margin="0,0,5,0"
                        Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=local:TrendChart}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=local:TrendChart}}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="?" Width="28" Padding="0" Style="{StaticResource IconButton}"
                        ToolTip="滚轮缩放、拖动平移、右键框选缩放。点击图例复选框显示或隐藏曲线，右键图例可修改该曲线的颜色、线宽与线型；悬浮图表可查看最近采样值。" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="清除曲线" MinWidth="80" Margin="0,0,6,0" Click="OnClearClick" />
                <Button Content="重置缩放" MinWidth="80" Margin="0,0,6,0" Click="OnResetZoomClick" />
                <ToggleButton x:Name="PauseButton" Content="暂停更新" MinWidth="86" Margin="0,0,6,0"
                              Checked="OnPauseChanged" Unchecked="OnPauseChanged" />
                <Button Content="快照 PNG…" MinWidth="90" Click="OnSnapshotClick" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="LegendScroll" Grid.Row="1" MaxHeight="58" Margin="0,0,0,4"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <ItemsControl x:Name="LegendItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,16,4" Tag="{Binding Id}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                  Checked="OnLegendVisibilityChanged" Unchecked="OnLegendVisibilityChanged"
                                  ToolTip="点击显示或隐藏曲线；右键修改颜色、线宽与线型">
                            <CheckBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="颜色">
                                        <MenuItem Header="蓝" Tag="#2563EB" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#2563EB" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="红" Tag="#DC2626" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#DC2626" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="绿" Tag="#059669" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#059669" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="橙" Tag="#D97706" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#D97706" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="紫" Tag="#7C3AED" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#7C3AED" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="青" Tag="#0891B2" Click="OnStyleColorClick">
                                            <MenuItem.Icon><Border Width="12" Height="12" Background="#0891B2" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="线宽">
                                        <MenuItem Header="1 px" Tag="1" Click="OnStyleWidthClick" />
                                        <MenuItem Header="1.5 px" Tag="1.5" Click="OnStyleWidthClick" />
                                        <MenuItem Header="2 px" Tag="2" Click="OnStyleWidthClick" />
                                        <MenuItem Header="3 px" Tag="3" Click="OnStyleWidthClick" />
                                    </MenuItem>
                                    <MenuItem Header="线型">
                                        <MenuItem Header="实线" Tag="Solid" Click="OnStylePatternClick" />
                                        <MenuItem Header="虚线" Tag="Dashed" Click="OnStylePatternClick" />
                                        <MenuItem Header="点线" Tag="Dotted" Click="OnStylePatternClick" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="重置此曲线样式" Click="OnStyleResetClick" />
                                    <MenuItem Header="重置全部曲线样式" Click="OnStyleResetAllClick" />
                                </ContextMenu>
                            </CheckBox.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{Binding ColorBrush}" CornerRadius="1" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Value}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Consolas" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid x:Name="PlotHost" Grid.Row="2" MouseMove="OnPlotMouseMove" MouseLeave="OnPlotMouseLeave"
              PreviewMouseWheel="OnPlotUserZoom" PreviewMouseDown="OnPlotUserPan">
            <sp:WpfPlot x:Name="PlotView" />
            <Canvas x:Name="TrackerOverlay" Background="Transparent" IsHitTestVisible="False">
                <Line x:Name="CrosshairLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                      StrokeDashArray="2,2" Visibility="Collapsed" />
                <Border x:Name="TrackerBorder" Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="9,7" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TrackerTime" Margin="0,0,0,4" FontFamily="Consolas" FontWeight="SemiBold" />
                        <ItemsControl x:Name="TrackerValues">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <Border Width="10" Height="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Background="{Binding ColorBrush}" CornerRadius="1" />
                                        <TextBlock Text="{Binding Title}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Canvas>
            <local:EmptyStateControl x:Name="EmptyState" Icon="&#xE7C4;" Title="暂无数据"
                                     Description="请先在主站调试页勾选“曲线”列并启动轮询。"
                                     Background="{DynamicResource PanelBrush}" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>

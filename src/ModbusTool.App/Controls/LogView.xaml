<UserControl x:Class="ModbusTool.App.Controls.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModbusTool.App.Controls">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,4">
            <TextBlock Text="级别" VerticalAlignment="Center" Margin="0,0,5,5" />
            <ComboBox x:Name="LevelFilterBox" Width="70" Margin="0,0,8,5" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="跟踪" />
                <ComboBoxItem Content="调试" />
                <ComboBoxItem Content="信息" />
                <ComboBoxItem Content="警告" />
                <ComboBoxItem Content="错误" />
            </ComboBox>
            <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,5,5" />
            <ComboBox x:Name="CategoryFilterBox" Width="105" Margin="0,0,8,5" IsEditable="True"
                      Text="全部" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="报文" />
                <ComboBoxItem Content="通信" />
                <ComboBoxItem Content="主站" />
                <ComboBoxItem Content="从站" />
                <ComboBoxItem Content="系统" />
            </ComboBox>
            <TextBlock Text="会话" VerticalAlignment="Center" Margin="0,0,5,5" />
            <TextBox x:Name="SessionFilterBox" Width="85" Margin="0,0,8,5" TextChanged="OnFilterChanged" />
            <TextBlock Text="功能码" VerticalAlignment="Center" Margin="0,0,5,5" />
            <ComboBox x:Name="FunctionFilterBox" Width="65" Margin="0,0,8,5" IsEditable="True"
                      Text="全部" SelectionChanged="OnFilterChanged" TextBoxBase.TextChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="01" />
                <ComboBoxItem Content="02" />
                <ComboBoxItem Content="03" />
                <ComboBoxItem Content="04" />
                <ComboBoxItem Content="05" />
                <ComboBoxItem Content="06" />
                <ComboBoxItem Content="0F" />
                <ComboBoxItem Content="10" />
            </ComboBox>
            <TextBlock Text="错误类型" VerticalAlignment="Center" Margin="0,0,5,5" />
            <ComboBox x:Name="ErrorTypeFilterBox" Width="80" Margin="0,0,8,5" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="超时" />
                <ComboBoxItem Content="CRC" />
                <ComboBoxItem Content="协议" />
                <ComboBoxItem Content="通信" />
                <ComboBoxItem Content="写入" />
                <ComboBoxItem Content="其他" />
            </ComboBox>
            <TextBlock Text="关键字" VerticalAlignment="Center" Margin="0,0,5,5" />
            <TextBox x:Name="KeywordFilterBox" Width="140" Margin="0,0,8,5" TextChanged="OnFilterChanged" />
            <Button Content="清空显示" Click="OnClearClick" Margin="0,0,5,5" />
            <Button Content="导出选中 CSV..." Click="OnExportSelectedClick" Margin="0,0,5,5" />
            <Button Content="导出全部 CSV..." Click="OnExportAllClick" Margin="0,0,5,5" />
            <CheckBox x:Name="VerboseBox" Content="调试日志" VerticalAlignment="Center" Margin="0,0,0,5"
                      Checked="OnVerboseChanged" Unchecked="OnVerboseChanged"
                      ToolTip="默认关闭。开启后记录调试级诊断；通信报文使用跟踪级独立记录。" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock Text="单文件上限(MB)" VerticalAlignment="Center" Margin="0,0,5,5" />
            <TextBox x:Name="MaxFileSizeBox" Width="55" Margin="0,0,8,5" Text="5" />
            <TextBlock Text="保留文件数(含当前)" VerticalAlignment="Center" Margin="0,0,5,5" />
            <TextBox x:Name="RetentionBox" Width="45" Margin="0,0,8,5" Text="5" />
            <Button Content="应用日志限制" Click="OnApplyLogSettingsClick" Margin="0,0,8,5" />
            <TextBlock Text="向下滚动分批加载较早记录；历史缓存上限 5000 条。" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid" IsReadOnly="True" EnableRowVirtualization="True"
                      EnableColumnVirtualization="True" AutoGenerateColumns="False"
                      SelectionMode="Extended" ScrollViewer.ScrollChanged="OnGridScrollChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="100" />
                    <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="55" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                    <DataGridTextColumn Header="会话 ID" Binding="{Binding SessionId}" Width="90" />
                    <DataGridTextColumn Header="站号" Binding="{Binding UnitIdText}" Width="50" />
                    <DataGridTextColumn Header="功能码" Binding="{Binding FunctionCodeText}" Width="65" />
                    <DataGridTextColumn Header="地址" Binding="{Binding RegisterAddressText}" Width="65" />
                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ElapsedMillisecondsText}" Width="75" />
                    <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="原始报文摘要" Binding="{Binding FrameSummary}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="错误类型" Binding="{Binding ErrorTypeText}" Width="75" />
                    <DataGridTextColumn Header="详细信息/异常堆栈" Binding="{Binding Details}" Width="*" MinWidth="180" />
                </DataGrid.Columns>
            </DataGrid>
            <local:EmptyStateControl x:Name="EmptyState" Icon="&#xE7C3;" Title="暂无日志"
                                     Description="操作监听、读写寄存器或发生通信异常时，运行日志会在这里记录。" Visibility="Collapsed" />
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</UserControl>

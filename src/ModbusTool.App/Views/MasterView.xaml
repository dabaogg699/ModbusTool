<UserControl x:Class="ModbusTool.App.Views.MasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModbusTool.App.Views"
             xmlns:controls="clr-namespace:ModbusTool.App.Controls">
    <Grid>
        <views:MasterDebugView x:Name="DebugPage" />
        <Grid x:Name="PacketPage" Visibility="Collapsed">
            <controls:PacketMonitor x:Name="PacketView" IsMaster="True" />
        </Grid>
        <views:MasterTrendView x:Name="TrendPage" Visibility="Collapsed" />
        <views:MasterManualView x:Name="ManualPage" Visibility="Collapsed" />
        <Grid x:Name="LogPage" Visibility="Collapsed">
            <controls:LogView />
        </Grid>
    </Grid>
</UserControl>

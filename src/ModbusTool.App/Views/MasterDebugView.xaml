<UserControl x:Class="ModbusTool.App.Views.MasterDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModbusTool.App.Views"
             xmlns:controls="clr-namespace:ModbusTool.App.Controls">
    <Grid SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" MaxHeight="430" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <Border Height="32" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Tag="Stations" Click="OnSummarySectionClick" Padding="9,1" Margin="0,0,5,0" ToolTip="展开从站列表与读取块配置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="从站 " /><TextBlock Text="{Binding Devices.Count}" FontWeight="SemiBold" />
                        <TextBlock Text=" · 读取块 " /><TextBlock Text="{Binding Blocks.Count}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Tag="Communication" Click="OnSummarySectionClick" Padding="9,1" Margin="0,0,5,0" ToolTip="展开通信方式、串口 / TCP 与超时重试配置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Connection.Kind}" /><TextBlock Text=" · 超时 " />
                        <TextBlock Text="{Binding Connection.ResponseTimeoutMs}" /><TextBlock Text=" ms" />
                    </StackPanel>
                </Button>
                <Button Tag="Health" Click="OnSummarySectionClick" Padding="9,1" ToolTip="{Binding StatisticsText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="实时健康" /><TextBlock Text="{Binding DeviceHealth.Count, StringFormat=' · {0} 站'}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 上区：按需展开的配置分组 -->
        <Grid Grid.Row="1">
        <ScrollViewer x:Name="UpperScroll" Visibility="Collapsed" ScrollChanged="OnUpperScrollChanged" SizeChanged="OnUpperScrollChanged"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander x:Name="StationsExpander" Header="从站列表 &amp; 读取块配置" IsExpanded="False"
                          ToolTip="双击单元格编辑；右键可批量启用、禁用、排序或设置轮询周期；从站行支持拖拽排序。">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel MinHeight="30" Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock Text="从站列表" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="添加" Command="{Binding AddDeviceCommand}" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="删除" Command="{Binding RemoveCommand}" CommandParameter="Device" Padding="8,2" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" MinHeight="96" MaxHeight="180">
                            <DataGrid x:Name="DevicesGrid" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      IsReadOnly="{Binding IsRunning}" CellEditEnding="OnDevicesEdited" AutoGenerateColumns="False"
                                      AllowDrop="True" PreviewMouseLeftButtonDown="OnDevicePreviewMouseLeftButtonDown"
                                      MouseMove="OnDeviceMouseMove" Drop="OnDeviceDrop"
                                      PreviewMouseRightButtonDown="OnGridRightButtonDown"
                                      ToolTip="站号、轮询周期、错开时间可直接编辑；拖拽行可调整轮询顺序。">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="批量启用全部从站" Click="OnEnableAllDevicesClick" />
                                        <MenuItem Header="批量禁用全部从站" Click="OnDisableAllDevicesClick" />
                                        <Separator />
                                        <MenuItem Header="上移选中从站" Click="OnMoveDeviceUpClick" />
                                        <MenuItem Header="下移选中从站" Click="OnMoveDeviceDownClick" />
                                        <Separator />
                                        <MenuItem Header="设置选中从站轮询周期..." Click="OnSetDeviceIntervalClick" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="70" />
                                    <DataGridTextColumn Header="站号" Binding="{Binding UnitId}" Width="48" />
                                    <DataGridTextColumn Header="周期 ms" Binding="{Binding PollIntervalMs}" Width="66" />
                                    <DataGridTextColumn Header="错开 ms" Binding="{Binding PollOffsetMs}" Width="62" />
                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="44" />
                                </DataGrid.Columns>
                            </DataGrid>
                                <controls:EmptyStateControl Icon="&#xE716;" Title="暂无从站"
                                                            Description="点击“添加”创建从站，或从“工作区”菜单导入点位 CSV。">
                                    <controls:EmptyStateControl.Style>
                                        <Style TargetType="controls:EmptyStateControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyStateControl.Style>
                                </controls:EmptyStateControl>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel MinHeight="30" Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock Text="读取块" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="添加" Command="{Binding AddBlockCommand}" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="删除" Command="{Binding RemoveCommand}" CommandParameter="Block" Padding="8,2" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" MinHeight="96" MaxHeight="180">
                            <DataGrid x:Name="BlocksGrid" ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock}"
                                      IsReadOnly="{Binding IsRunning}" CellEditEnding="OnBlocksEdited" AutoGenerateColumns="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      ToolTip="功能码、起始地址与数量可编辑；启动轮询前会校验地址、数量和点位范围。">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="72" />
                                    <DataGridTemplateColumn Header="功能码" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Function}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.ReadFunctions, RelativeSource={RelativeSource AncestorType=views:MasterDebugView}}"
                                                          DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Function}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="起始" Binding="{Binding StartAddress}" Width="62" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="58" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding LastStatus}" IsReadOnly="True" Width="90" />
                                    <DataGridTextColumn Header="响应 ms" Binding="{Binding LastResponseMilliseconds, StringFormat=F3}" IsReadOnly="True" Width="78" />
                                </DataGrid.Columns>
                            </DataGrid>
                                <controls:EmptyStateControl Icon="&#xE7C3;" Title="暂无读取块"
                                                            Description="先选择从站，再点击“添加”创建读取块。">
                                    <controls:EmptyStateControl.Style>
                                        <Style TargetType="controls:EmptyStateControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Blocks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyStateControl.Style>
                                </controls:EmptyStateControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Expander>

                <Expander x:Name="CommExpander" Header="通信参数（RTU / TCP、串口参数、超时重试）" IsExpanded="False"
                          ToolTip="启动后锁定配置；串口不能被其他会话或程序同时占用。">
                    <StackPanel LostFocus="OnConnectionEdited">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <GroupBox Grid.Row="0" Grid.Column="0" Header="启动控制" Margin="0,0,8,8">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="启动主站" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                                                MinWidth="105" Margin="0,0,6,0" />
                                        <Button Content="停止" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" MinWidth="80" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Text="启动后锁定连接配置，停止后可继续离线编辑。" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Row="0" Grid.Column="1" Header="超时与重试" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" /><ColumnDefinition Width="*" MinWidth="68" />
                                        <ColumnDefinition Width="72" /><ColumnDefinition Width="*" MinWidth="68" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="响应超时 ms" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.ResponseTimeoutMs}" />
                                    <TextBlock Grid.Column="2" Text="重试次数" Style="{StaticResource FieldLabel}" Margin="4,2,0,2" MinWidth="0" />
                                    <TextBox Grid.Column="3" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.RetryCount}" />
                                    <TextBlock Grid.Row="1" Text="重试间隔 ms" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.RetryDelayMs}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="重连间隔 ms" Style="{StaticResource FieldLabel}" Margin="4,2,0,2" MinWidth="0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.ReconnectDelayMs}" />
                                    <TextBlock Grid.Row="2" Text="报文间隔 ms" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.FrameIntervalMs}" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Grid.Column="0" Header="通信方式" Margin="0,0,8,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="连接类型" Width="70" DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                        <ComboBox ItemsSource="{Binding ConnectionKinds}" SelectedItem="{Binding Connection.Kind}"
                                                  IsEnabled="{Binding IsOffline}" SelectionChanged="OnConnectionSelectionChanged"
                                                  Style="{StaticResource FieldComboBox}" MinWidth="0" />
                                    </DockPanel>
                                    <Grid IsEnabled="{Binding IsOffline}" Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTcpConnection}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" /><ColumnDefinition Width="*" MinWidth="68" />
                                                <ColumnDefinition Width="52" /><ColumnDefinition Width="*" MinWidth="68" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="串口" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                            <DockPanel Grid.Column="1" Grid.ColumnSpan="3">
                                                <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPortsCommand}"
                                                        Style="{StaticResource SecondaryButton}" Padding="6,2" Margin="4,2,4,2" />
                                                <ComboBox ItemsSource="{Binding PortNames}" IsEditable="True" Text="{Binding Connection.PortName}"
                                                          Style="{StaticResource FieldComboBox}" MinWidth="0" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BaudRateComboBox}" MinWidth="0"
                                          ItemsSource="{Binding BaudRates}" Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="数据位" Style="{StaticResource FieldLabel}" Margin="4,2,0,2" MinWidth="0" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.DataBits}" />
                                            <TextBlock Grid.Row="2" Text="校验位" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldComboBox}" MinWidth="0"
                                                      ItemsSource="{Binding Parities}" SelectedItem="{Binding Connection.Parity}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="停止位" Style="{StaticResource FieldLabel}" Margin="4,2,0,2" MinWidth="0" />
                                            <ComboBox Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldComboBox}" MinWidth="0"
                                                      ItemsSource="{Binding StopBitNames}" SelectedItem="{Binding Connection.StopBits}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTcpConnection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" /><ColumnDefinition Width="*" MinWidth="68" />
                                                <ColumnDefinition Width="52" /><ColumnDefinition Width="*" MinWidth="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="主机 / IP" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.Host}" />
                                            <TextBlock Grid.Column="2" Text="端口" Style="{StaticResource FieldLabel}" Margin="4,2,0,2" MinWidth="0" />
                                            <TextBox Grid.Column="3" Style="{StaticResource FieldTextBox}" MinWidth="0" Text="{Binding Connection.Port}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Grid.Column="1" Header="队列与运行状态">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="队列容量" Style="{StaticResource FieldLabel}" Margin="0,2" MinWidth="0" />
                                        <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding Connection.QueueCapacity}" />
                                    </Grid>
                                    <TextBlock Text="{Binding StatisticsText}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Name="HealthExpander" Header="实时健康统计（成功率 / 超时 / 错误计数）" IsExpanded="False"
                          ToolTip="通信帧统计与每个从站的成功、超时、错误、成功率，列宽可用鼠标拖动。">
                    <StackPanel>
                        <TextBlock Text="{Binding StatisticsText}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6" />
                        <DataGrid x:Name="HealthGrid" ItemsSource="{Binding DeviceHealth}" IsReadOnly="True" AutoGenerateColumns="False"
                                  MinHeight="110" MaxHeight="190" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="站号" Binding="{Binding UnitId}" Width="*" MinWidth="42" />
                                <DataGridTextColumn Header="成功" Binding="{Binding Successes}" Width="*" MinWidth="42" />
                                <DataGridTextColumn Header="超时" Binding="{Binding Timeouts}" Width="*" MinWidth="42" />
                                <DataGridTextColumn Header="错误" Binding="{Binding Errors}" Width="*" MinWidth="42" />
                                <DataGridTextColumn Header="成功率" Binding="{Binding SuccessRate}" Width="*" MinWidth="56" />
                                <DataGridTextColumn Header="平均" Binding="{Binding AverageText}" Width="*" MinWidth="64" />
                                <DataGridTemplateColumn Header="状态" Width="*" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusUnknownBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Fresh">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusFreshBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Stale">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusStaleBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
            <Border x:Name="UpperOverflowHint" Height="24" VerticalAlignment="Bottom" Visibility="Collapsed"
                    Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Opacity="0.96" IsHitTestVisible="False">
                <TextBlock Text="↓ 下方还有内容，滚动查看" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
        </Grid>

        <GridSplitter x:Name="UpperSplitter" Grid.Row="2" Height="4" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      ToolTip="拖动调整配置区与点位表格的高度比例" />

        <!-- 下区：主点位表格区 -->
        <TabControl Grid.Row="3" Margin="0,10,0,0">
            <TabItem Header="实时值">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,6" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                               Text="当前读取块原始值" />
                    <controls:RegisterGrid Grid.Row="1" ItemsSource="{Binding Registers}"
                                           IsReadOnly="{Binding IsRegisterGridReadOnly}"
                                           AllowWriteMenu="{Binding IsRegisterWriteEnabled}"
                                           ValueEditing="OnRegisterValueEditing" ValueWriteRequested="OnRegisterWriteRequested"
                                           ExportCommand="{Binding ExportRegistersCommand}" EmptyTitle="暂无实时值">
                        <controls:RegisterGrid.Style>
                            <Style TargetType="controls:RegisterGrid">
                                <Setter Property="EmptyDescription" Value="点击“启动主站”后此处显示读取值。" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="EmptyDescription" Value="当前会话没有读取块或尚未生成读取值，请展开上方“从站”摘要检查配置。" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:RegisterGrid.Style>
                    </controls:RegisterGrid>
                </Grid>
            </TabItem>
            <TabItem Header="点位定义">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock Text="数值点位（按分组折叠）" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                   ToolTip="地址偏移相对于读取块起始地址；UInt16/Int16 占 1 个寄存器，32 位占 2 个，64 位/Double 占 4 个。" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="新建分组..." Click="OnAddGroupClick" Margin="0,0,5,0" />
                            <Button Content="添加点位" Command="{Binding AddPointCommand}" Margin="0,0,5,0" />
                            <Button Content="删除点位" Command="{Binding RemoveCommand}" CommandParameter="Point" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PointGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,6" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PointCount, StringFormat='（{0} 个）'}" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                                    <Button Content="加点" Click="OnGroupAddPointClick" Padding="5,1" Margin="0,0,3,0" ToolTip="在分组内添加点位" />
                                                    <Button Content="曲线开" Click="OnGroupEnableHistoryClick" Padding="5,1" Margin="0,0,3,0" ToolTip="分组内点位全部加入历史曲线" />
                                                    <Button Content="曲线关" Click="OnGroupDisableHistoryClick" Padding="5,1" Margin="0,0,3,0" ToolTip="分组内点位全部移出历史曲线" />
                                                    <Button Content="清空" Click="OnGroupRemovePointsClick" Padding="5,1" ToolTip="删除分组内全部点位" />
                                                </WrapPanel>
                                            </DockPanel>
                                        </Expander.Header>
                                        <DataGrid ItemsSource="{Binding Points}"
                                                  SelectedItem="{Binding DataContext.SelectedPoint, RelativeSource={RelativeSource AncestorType=views:MasterDebugView}, Mode=TwoWay}"
                                                  IsReadOnly="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=views:MasterDebugView}}"
                                                  CellEditEnding="OnPointsEdited" AutoGenerateColumns="False" MinHeight="110" MaxHeight="300"
                                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseRightButtonDown="OnGridRightButtonDown"
                                                  ToolTip="双击单元格编辑；右键可批量添加、复制、写入、导出或设置数据类型与字节序。">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="添加点位" Click="OnAddPointMenuClick" />
                                                    <MenuItem Header="批量添加 10 个点位" Click="OnBatchAddPointsClick" />
                                                    <MenuItem Header="复制选中点位" Click="OnDuplicatePointClick" />
                                                    <MenuItem Header="删除选中点位" Click="OnRemovePointClick" />
                                                    <Separator />
                                                    <MenuItem Header="写入选中点位值..." Click="OnWritePointValueClick" />
                                                    <MenuItem Header="导出选中点位..." Click="OnExportSelectedPointClick" />
                                                    <Separator />
                                                    <MenuItem Header="设置数据类型">
                                                        <MenuItem Header="UInt16" Tag="UInt16" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="Int16" Tag="Int16" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="UInt32" Tag="UInt32" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="Int32" Tag="Int32" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="UInt64" Tag="UInt64" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="Int64" Tag="Int64" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="Float" Tag="Float" Click="OnPointDataTypeClick" />
                                                        <MenuItem Header="Double" Tag="Double" Click="OnPointDataTypeClick" />
                                                    </MenuItem>
                                                    <MenuItem Header="设置字节序">
                                                        <MenuItem Header="ABCD (Order1032)" Tag="Order1032" Click="OnPointByteOrderClick" />
                                                        <MenuItem Header="DCBA (Order3210)" Tag="Order3210" Click="OnPointByteOrderClick" />
                                                        <MenuItem Header="BADC (Order0123)" Tag="Order0123" Click="OnPointByteOrderClick" />
                                                        <MenuItem Header="CDAB (Order2301)" Tag="Order2301" Click="OnPointByteOrderClick" />
                                                    </MenuItem>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                                                <DataGridTextColumn Header="偏移" Binding="{Binding AddressOffset}" Width="60" />
                                                <DataGridTemplateColumn Header="数据类型" Width="105">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DataType}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate><ComboBox ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=views:MasterDebugView}}" SelectedItem="{Binding DataType}" /></DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="字节序" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ByteOrder}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate><ComboBox ItemsSource="{Binding DataContext.ByteOrders, RelativeSource={RelativeSource AncestorType=views:MasterDebugView}}" SelectedItem="{Binding ByteOrder}" /></DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="倍率" Binding="{Binding Scale}" Width="75" />
                                                <DataGridTextColumn Header="偏移量" Binding="{Binding Offset}" Width="75" />
                                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65" />
                                                <DataGridCheckBoxColumn Header="曲线" Binding="{Binding CurveEnabled}" Width="50" />
                                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="160" />
                                                <DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="110" />
                                                <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" IsReadOnly="True" Width="100" />
                                                <DataGridTextColumn Header="工程量" Binding="{Binding ScaledValue}" IsReadOnly="True" Width="120" />
                                                <DataGridTextColumn Header="更新时间" Binding="{Binding LastUpdated, StringFormat={}{0:HH:mm:ss.fff}}" IsReadOnly="True" Width="105" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

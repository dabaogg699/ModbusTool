<UserControl x:Class="ModbusTool.App.Views.SlaveDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ModbusTool.App.Controls">
    <Grid SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" MaxHeight="430" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="启动监听" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" />
                <Button Content="停止监听" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                <Button Content="配置 ▾" Click="OnMenuClick" Margin="0,0,5,0">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="导入旧 config…" Command="{Binding ImportLegacyConfigCommand}" />
                            <MenuItem Header="保存配置" Command="{Binding SaveConfigurationCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="数据 ▾" Click="OnMenuClick" Margin="0,0,5,0">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="加载数据…" Command="{Binding LoadDataCommand}" />
                            <MenuItem Header="保存数据" Command="{Binding SaveDataCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="导出 ▾" Click="OnMenuClick" Margin="0,0,5,0">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="导出当前表…" Command="{Binding ExportRegistersCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="?" Width="28" Padding="0" Style="{StaticResource IconButton}"
                        ToolTip="四区独立内存；双击值可直接编辑，通信与仿真均在后台执行。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Height="32" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="5,2">
            <StackPanel Orientation="Horizontal">
                <Button Tag="Listen" Click="OnSummarySectionClick" Padding="9,1" Margin="0,0,5,0"
                        ToolTip="{Binding StatisticsText}">
                    <TextBlock Text="{Binding ListenerSummary}" />
                </Button>
                <Button Tag="Stations" Click="OnSummarySectionClick" Padding="9,1" Margin="0,0,5,0"
                        ToolTip="展开站号列表与 TCP 客户端">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="站号 " /><TextBlock Text="{Binding Stations.Count}" FontWeight="SemiBold" />
                        <TextBlock Text=" · 客户端 " /><TextBlock Text="{Binding Clients.Count}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding DataFileName}" VerticalAlignment="Center" Margin="5,0,12,0"
                           Foreground="{DynamicResource MutedTextBrush}" ToolTip="{Binding DataFilePath}" />
                <TextBlock Text="{Binding RequestSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
        <ScrollViewer x:Name="UpperScroll" Visibility="Collapsed" ScrollChanged="OnUpperScrollChanged" SizeChanged="OnUpperScrollChanged"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander x:Name="StationsExpander" Header="站号与客户端" IsExpanded="False"
                          ToolTip="每个站号拥有独立数据区；TCP 客户端列表展示当前连接。">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                <TextBlock Text="站号列表" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="站号" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Width="55" Style="{StaticResource FieldTextBox}" Text="{Binding NewUnitId}" />
                                    <Button Content="添加" Command="{Binding AddStationCommand}" Margin="0,0,4,0" />
                                    <Button Content="删除" Command="{Binding RemoveStationCommand}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" MinHeight="96" MaxHeight="150">
                            <DataGrid x:Name="StationsGrid" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                      IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="站号" Binding="{Binding UnitId}" Width="*" MinWidth="45" />
                                    <DataGridTextColumn Header="请求" Binding="{Binding RequestCount}" Width="*" MinWidth="55" />
                                    <DataGridTextColumn Header="耗时 ms" Binding="{Binding LastResponseMilliseconds, StringFormat=F3}" Width="*" MinWidth="70" />
                                    <DataGridTextColumn Header="最后状态" Binding="{Binding LastStatus}" Width="2*" MinWidth="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                                <controls:EmptyStateControl Icon="&#xE716;" Title="暂无站号"
                                                            Description="输入站号并点击“添加”，每个站号拥有独立数据区。">
                                    <controls:EmptyStateControl.Style>
                                        <Style TargetType="controls:EmptyStateControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stations.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyStateControl.Style>
                                </controls:EmptyStateControl>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="TCP 客户端" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <Grid Grid.Row="1" MinHeight="96" MaxHeight="150">
                                <Rectangle Fill="{DynamicResource PanelAltBrush}" Stroke="{DynamicResource BorderBrush}"
                                           StrokeDashArray="3 2" RadiusX="4" RadiusY="4" />
                                <ListBox ItemsSource="{Binding Clients}" DisplayMemberPath="DisplayName"
                                         Background="Transparent" BorderThickness="0" />
                                <controls:EmptyStateControl Icon="&#xE774;" Title="暂无 TCP 客户端"
                                                            Description="启动监听后，此处显示已连接客户端。">
                                    <controls:EmptyStateControl.Style>
                                        <Style TargetType="controls:EmptyStateControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:EmptyStateControl.Style>
                                </controls:EmptyStateControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Expander>

                <Expander x:Name="ListenExpander" Header="监听与持久化（TCP / RTU、数据文件、实时统计）" IsExpanded="False"
                          ToolTip="TCP 与 RTU 可同时启动；站号 1 默认 data.bin，其余站号使用 data-站号.bin。">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="280" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Modbus TCP 服务端" IsEnabled="{Binding IsOffline}" Margin="0,0,10,8">
                            <StackPanel>
                                <CheckBox Content="启用 TCP 监听" IsChecked="{Binding UseTcp}" />
                                <Grid IsEnabled="{Binding UseTcp}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="监听 IP" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding TcpAddress}" />
                                    <TextBlock Grid.Row="1" Text="端口" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding TcpPort}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Modbus RTU 从站" IsEnabled="{Binding IsOffline}" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox Content="启用串口监听" IsChecked="{Binding UseSerial}" />
                                <Grid IsEnabled="{Binding UseSerial}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="串口" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPortsCommand}" Padding="6,2" Margin="4,0,0,0" />
                                        <ComboBox ItemsSource="{Binding PortNames}" IsEditable="True" Text="{Binding PortName}" Style="{StaticResource FieldComboBox}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="波特率" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource BaudRateComboBox}"
                                  ItemsSource="{Binding BaudRates}" Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="数据位" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding DataBits}" />
                                    <TextBlock Grid.Row="3" Text="校验位" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Parities}" SelectedItem="{Binding Parity}" />
                                    <TextBlock Grid.Row="4" Text="停止位" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding StopBitNames}" SelectedItem="{Binding StopBits}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="当前站号持久化" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="数据文件" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Text="{Binding DataFilePath}" TextWrapping="Wrap" Style="{StaticResource FieldTextBox}" />
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Content="加载..." Command="{Binding LoadDataCommand}" Margin="0,0,5,0" />
                                    <Button Content="保存" Command="{Binding SaveDataCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="实时统计 / 最后错误">
                            <StackPanel>
                                <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" FontSize="11" LineHeight="18" />
                                <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ErrorBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
            <Border x:Name="UpperOverflowHint" Height="24" VerticalAlignment="Bottom" Visibility="Collapsed"
                    Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Opacity="0.96" IsHitTestVisible="False">
                <TextBlock Text="↓ 下方还有内容，滚动查看" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
        </Grid>

        <GridSplitter x:Name="UpperSplitter" Grid.Row="3" Height="4" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      ToolTip="拖动调整配置区与数据区的高度比例" />

        <TabControl Grid.Row="4" Margin="0,10,0,0">
            <TabItem Header="四区数据">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <ComboBox Width="135" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding DataAreas}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value" SelectedValue="{Binding SelectedArea}" />
                        <TextBlock Text="起始" Style="{StaticResource FieldLabel}" MinWidth="32" />
                        <TextBox Width="65" Style="{StaticResource FieldTextBox}" Text="{Binding GridStartAddress}" />
                        <TextBlock Text="数量" Style="{StaticResource FieldLabel}" MinWidth="32" />
                        <TextBox Width="55" Style="{StaticResource FieldTextBox}" Text="{Binding GridDisplayCount}" />
                        <Button Content="刷新范围" Command="{Binding RefreshGridCommand}" Margin="4,2,10,2" />
                        <TextBlock Text="编码" Style="{StaticResource FieldLabel}" MinWidth="32" />
                        <ComboBox Width="90" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" />
                        <CheckBox Content="交换字节" IsChecked="{Binding SwapStringBytes}" Margin="8,0,0,0" />
                    </WrapPanel>
                    <controls:RegisterGrid Grid.Row="1" ItemsSource="{Binding Registers}" ValueEditing="OnRegisterValueEditing"
                                           ExportCommand="{Binding ExportRegistersCommand}" EmptyTitle="暂无寄存器数据"
                                           EmptyDescription="调整起始地址和数量后点击“刷新范围”，或选择其他站号与数据区。" />
                </Grid>
            </TabItem>

            <TabItem Header="字符串工具">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="多寄存器字符串解析与写入（使用当前选中的站号和数据区）">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}" MinWidth="60" />
                                    <TextBox Width="70" Style="{StaticResource FieldTextBox}" Text="{Binding StringAddress}" />
                                    <TextBlock Text="寄存器数" Style="{StaticResource FieldLabel}" MinWidth="60" />
                                    <TextBox Width="60" Style="{StaticResource FieldTextBox}" Text="{Binding StringRegisterCount}" />
                                    <ComboBox Width="100" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" />
                                    <CheckBox Content="交换相邻字节" IsChecked="{Binding SwapStringBytes}" Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock Text="待写入字符串" Margin="0,6,0,4" FontSize="12" />
                                <TextBox Text="{Binding StringText, UpdateSourceTrigger=PropertyChanged}" MinHeight="65" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Button Content="写入字符串" Command="{Binding EncodeStringCommand}" Margin="0,0,6,0" />
                                    <Button Content="从寄存器解码" Command="{Binding DecodeStringCommand}" />
                                </StackPanel>
                                <TextBlock Text="解码结果" Margin="0,5,0,4" FontSize="12" />
                                <TextBox Text="{Binding DecodedString, Mode=OneWay}" IsReadOnly="True" MinHeight="90" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="GB2312、UTF-8、Unicode 和 ASCII 均使用统一字节序转换；写入长度不能超过所选寄存器容量。" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="自增 / 随机仿真">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="寄存器数据仿真（作用于当前选中站号）"
                                  ToolTip="自增到达上限后回到下限；负步长到达下限后回到上限；随机值在最小值和最大值之间生成。">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="模式" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding SimulationModes}" SelectedItem="{Binding SimulationMode}" />
                                <TextBlock Grid.Row="1" Text="数据区" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding RegisterAreas}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value" SelectedValue="{Binding SimulationArea}" />
                                <TextBlock Grid.Row="2" Text="起始地址" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationStartAddress}" />
                                <TextBlock Grid.Row="3" Text="寄存器数量" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationRegisterCount}" />
                                <TextBlock Grid.Row="4" Text="周期 ms" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationIntervalMs}" />
                                <TextBlock Grid.Row="5" Text="数据类型" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding SimulationDataType}" />
                                <TextBlock Grid.Row="6" Text="字节序" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <ComboBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding SimulationByteOrder}" />
                                <TextBlock Grid.Row="7" Text="最小值" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationMinimum}" />
                                <TextBlock Grid.Row="8" Text="最大值" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationMaximum}" />
                                <TextBlock Grid.Row="9" Text="自增步长" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="{Binding SimulationStep}" />
                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="启动数据仿真" Command="{Binding StartDataSimulationCommand}" Margin="0,0,6,0" />
                                    <Button Content="停止数据仿真" Command="{Binding StopDataSimulationCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Grid.RowSpan="10" Margin="22,3,3,3" VerticalAlignment="Top" TextWrapping="Wrap"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="寄存器数量必须是当前数据类型所占寄存器数的整数倍，所有字节序与原程序一致。" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="干扰报文">
                <GroupBox Header="随机干扰报文" Margin="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="?" Width="28" Padding="0" Margin="8,0" Style="{StaticResource IconButton}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <TextBlock Width="340" TextWrapping="Wrap"
                                                       Text="向勾选的 TCP 客户端或 RTU 串口发送指定间隔与长度范围内的随机原始字节。启动新的干扰会替代上一次发送循环；停止干扰不会影响寄存器数据仿真。" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="启动干扰" Command="{Binding StartNoiseCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" />
                                <Button Content="停止干扰" Command="{Binding StopOutputCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="间隔" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="58" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding NoiseMinimumIntervalMs}" />
                                <TextBlock Text="–" VerticalAlignment="Center" />
                                <TextBox Width="58" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding NoiseMaximumIntervalMs}" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="长度" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="58" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding NoiseMinimumLength}" />
                                <TextBlock Text="–" VerticalAlignment="Center" />
                                <TextBox Width="58" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding NoiseMaximumLength}" />
                                <TextBlock Text="字节" VerticalAlignment="Center" />
                            </WrapPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                            <CheckBox Content="全部 TCP 客户端" IsChecked="{Binding SendSimulationToTcp}" Margin="0,0,18,0" />
                            <CheckBox Content="RTU 串口" IsChecked="{Binding SendSimulationToSerial}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </TabItem>

            <TabItem Header="故障注入">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="真实响应链路故障配置" Margin="8">
                        <StackPanel>
                            <CheckBox Content="启用故障注入" IsChecked="{Binding FaultEnabled}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="丢包概率" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Column="1" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding DropProbabilityPercent}" />
                                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="错误值概率" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding InvalidValueProbabilityPercent}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="错误 CRC 概率" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Row="2" Grid.Column="1" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding InvalidCrcProbabilityPercent}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="%（仅 RTU）" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="固定响应延迟" Style="{StaticResource FieldLabel}" MinWidth="0" />
                                    <TextBox Grid.Column="1" MinWidth="0" Style="{StaticResource FieldTextBox}" Text="{Binding ResponseDelayMs}" />
                                    <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="1" Content="强制返回异常码" IsChecked="{Binding ForceException}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="0" Style="{StaticResource FieldComboBox}"
                                              ItemsSource="{Binding ExceptionCodes}" SelectedItem="{Binding ForcedExceptionCode}" />
                                </Grid>
                            </Grid>
                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Content="?" Width="28" Padding="0" Style="{StaticResource IconButton}">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <TextBlock Width="390" TextWrapping="Wrap"
                                                       Text="概率范围为 0～100。故障作用于真实响应链路：丢包优先于其他故障，强制异常优先于错误值，错误 CRC 只修改 RTU 帧。每次启动监听也会应用当前配置。异常帧会进入报文监视器，可按站号、功能码、CRC 与收发方向筛选；CRC 错误显示为红色，异常响应显示为橙色。" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="应用故障配置" Command="{Binding ApplyFaultsCommand}"
                                        Style="{StaticResource PrimaryButton}" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

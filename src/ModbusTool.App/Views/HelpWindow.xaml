<Window x:Class="ModbusTool.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助" Width="780" Height="800" MinWidth="620" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                    Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding Title}" Margin="0,0,0,10">
                            <StackPanel Margin="6,2">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" LineHeight="19"
                                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" LineHeight="19" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="关闭" Width="88" HorizontalAlignment="Right" Margin="0,8,0,0"
                IsCancel="True" Style="{DynamicResource SecondaryButton}" />
    </Grid>
</Window>

<UserControl x:Class="ModbusTool.App.Views.SlaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ModbusTool.App.Views"
             xmlns:controls="clr-namespace:ModbusTool.App.Controls"
             Loaded="OnLoaded">
    <Grid>
        <views:SlaveDebugView x:Name="DebugPage" />
        <Grid x:Name="PacketPage" Visibility="Collapsed">
            <controls:PacketMonitor x:Name="PacketView" AutoDetect="True" />
        </Grid>
        <Grid x:Name="LogPage" Visibility="Collapsed">
            <controls:LogView />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="ModbusTool.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                    Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="软件信息" Margin="0,12,0,0">
            <Grid Margin="6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="程序" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3" />
                <TextBlock Grid.Column="1" Text="{Binding ProductName}" Margin="0,3" />
                <TextBlock Grid.Column="2" Text="版本" Foreground="{DynamicResource MutedTextBrush}" Margin="12,3,0,3" />
                <TextBlock Grid.Column="3" Text="{Binding Version}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="可执行文件" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileName}" Margin="0,3" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="运行环境" Foreground="{DynamicResource MutedTextBrush}" Margin="12,3,0,3" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Runtime}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="署名" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Author}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="构建时间" Foreground="{DynamicResource MutedTextBrush}" Margin="12,3,0,3" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding BuildTime}" Margin="0,3" FontSize="11" />
                <TextBlock Grid.Row="3" Text="编译 SDK" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BuildSdk}" Margin="0,3" FontSize="11" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="功能简介" Margin="0,10,0,0">
            <TextBlock Text="{Binding FeatureSummary}" TextWrapping="Wrap" Margin="6,2" FontSize="11" LineHeight="19" />
        </GroupBox>

        <GroupBox Grid.Row="3" Header="自研与依赖说明" Margin="0,10,0,0">
            <StackPanel Margin="6,2">
                <TextBlock Text="{Binding SelfDevelopedNote}" TextWrapping="Wrap" FontSize="11" LineHeight="18" />
                <TextBlock Text="{Binding ModbusCoreNote}" TextWrapping="Wrap" FontSize="11" LineHeight="18" Margin="0,5,0,0" />
                <TextBlock Text="{Binding AuthorLine}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                <TextBlock Text="{Binding EmailLine}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding LicenseNotice}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{Binding RepositoryUrl}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="相关资源" Margin="0,10,0,0">
            <StackPanel Margin="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12">
                            <Hyperlink Command="{Binding OpenHelpDocumentCommand}" ToolTip="{Binding HelpDocumentUrl}">
                                <Run Text="📄 帮助文档" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding HelpDocumentUrl}" FontSize="9" Margin="0,3,0,0" MaxWidth="250"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12">
                            <Hyperlink Command="{Binding OpenDebugDocumentCommand}" ToolTip="{Binding DebugDocumentUrl}">
                                <Run Text="🔧 调试辅助文档" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding DebugDocumentUrl}" FontSize="9" Margin="0,3,0,0" MaxWidth="250"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 微信打赏二维码：以 WPF Resource 嵌入 ModbusTool 程序集（AssemblyName 为 ModbusTool，非 ModbusTool.App）。 -->
                <Border HorizontalAlignment="Center" Margin="0,12,0,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <Image Source="/ModbusTool;component/Assets/wechat-donate-qr.png"
                               Width="150" Height="150" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="微信扫码打赏作者" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="5" Text="{Binding Copyright}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
    </Grid>
</UserControl>

<UserControl x:Class="ModbusTool.App.Views.MasterManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ModbusTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="手动命令（全功能码读写，优先于自动轮询）" />
        <Expander Grid.Row="1" Header="报文下发参数" IsExpanded="True"
                  ToolTip="多值使用逗号、分号或空格分隔；线圈支持 0/1/ON/OFF；寄存器支持 0x 前缀。">
            <WrapPanel>
                <TextBlock Text="功能码" Style="{StaticResource FieldLabel}" MinWidth="50" />
                <ComboBox Width="165" Style="{StaticResource FieldComboBox}" ItemsSource="{Binding ManualFunctions}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ManualFunction}" />
                <TextBlock Text="站号" Style="{StaticResource FieldLabel}" MinWidth="40" />
                <TextBox Width="60" Style="{StaticResource FieldTextBox}" Text="{Binding ManualUnitId}" />
                <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}" MinWidth="62" />
                <TextBox Width="80" Style="{StaticResource FieldTextBox}" Text="{Binding ManualAddress}" />
                <TextBlock Text="读取数量" Style="{StaticResource FieldLabel}" MinWidth="62" />
                <TextBox Width="65" Style="{StaticResource FieldTextBox}" Text="{Binding ManualQuantity}" />
                <TextBlock Text="写入值" Style="{StaticResource FieldLabel}" MinWidth="50" />
                <TextBox Width="240" Style="{StaticResource FieldTextBox}" Text="{Binding ManualValuesText}" />
                <Button Content="执行命令" Command="{Binding ManualExecuteCommand}" MinWidth="95" Margin="6,2,0,2" />
            </WrapPanel>
        </Expander>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,8,0,6" Text="{Binding LastManualResponse}" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" FontSize="11" />
            <controls:RegisterGrid Grid.Row="1" ItemsSource="{Binding ManualResults}" IsReadOnly="True"
                                   EmptyTitle="尚未执行命令" EmptyDescription="设置功能码、站号与地址后点击“执行命令”，结果将在此显示。" />
        </Grid>
    </Grid>
</UserControl>

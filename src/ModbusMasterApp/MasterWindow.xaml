<Window x:Class="ModbusMasterApp.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ModbusTool.App.Views;assembly=ModbusTool"
        xmlns:controls="clr-namespace:ModbusTool.App.Controls;assembly=ModbusTool"
        Title="ModbusMaster - Modbus 主站调试工具" Height="880" Width="1440" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Closing="OnClosing" Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="&#xE897;" Width="30" Padding="0" Click="OnHelpClick" Margin="0,0,4,0"
                            Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFontFamily}"
                            ToolTip="查看会话、点位、报文与趋势操作说明" />
                    <Button Content="&#xE946;" Width="30" Padding="0" Click="OnAboutClick" Margin="0,0,6,0"
                            Style="{StaticResource IconButton}" FontFamily="{StaticResource IconFontFamily}"
                            ToolTip="关于 ModbusMaster" />
                    <controls:ThemeSelector VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ModbusMaster" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderTextBrush}" />
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.7" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="6,1" Margin="8,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="主站" Foreground="{DynamicResource OnAccentBrush}" FontSize="10" />
                    </Border>
                    <ComboBox x:Name="SessionComboBox" Width="160" MinHeight="28" Margin="0,0,4,0"
                              ItemsSource="{Binding SessionViewModels, ElementName=MasterSessionsControl}"
                              SelectedItem="{Binding SelectedViewModel, ElementName=MasterSessionsControl, Mode=TwoWay}"
                              ToolTip="当前会话：所有视图共享，切换后保持当前导航页">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkspaceDisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="⋮" Width="30" Padding="0" Margin="0,0,5,0" Click="OnSessionMenuClick"
                            Style="{StaticResource IconButton}" ToolTip="新建、复制、关闭或重命名会话">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建会话" Click="OnNewSessionClick" />
                                <MenuItem Header="复制当前会话" Click="OnDuplicateSessionClick" />
                                <MenuItem Header="重命名当前会话..." Click="OnRenameSessionClick" />
                                <Separator />
                                <MenuItem Header="关闭当前会话" Click="OnCloseSessionClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="工作区 ▾" Click="OnWorkspaceMenuClick" Padding="9,3"
                            Tag="{Binding SelectedViewModel, ElementName=MasterSessionsControl}"
                            ToolTip="打开、保存、模板与 CSV 导入导出">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开工作区..." Command="{Binding OpenCommand}" />
                                <MenuItem Header="导入旧 config..." Command="{Binding ImportLegacyCommand}" />
                                <Separator />
                                <MenuItem Header="保存" Command="{Binding SaveCommand}" />
                                <MenuItem Header="另存为..." Command="{Binding SaveAsCommand}" />
                                <MenuItem Header="存为模板..." Command="{Binding SaveTemplateCommand}" />
                                <MenuItem Header="从模板新建..." Command="{Binding NewFromTemplateCommand}" />
                                <Separator />
                                <MenuItem Header="重置为初始模板" Click="OnResetTemplateClick" />
                                <Separator />
                                <MenuItem Header="导入点位 CSV..." Command="{Binding ImportPointsCommand}" />
                                <MenuItem Header="导出点位 IO 表..." Command="{Binding ExportPointsCommand}" />
                                <MenuItem Header="导出旧版 CSV（推断）..." Command="{Binding ExportLegacyCsvCommand}" />
                                <MenuItem Header="导出历史 CSV..." Command="{Binding ExportHistoryCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="Modbus 主站调试工具" FontSize="10" Foreground="{DynamicResource NavTextBrush}" Opacity="0.7" />
                            <TextBlock Text="{Binding Text, ElementName=VersionText}" FontSize="10" Margin="0,3,0,0"
                                       Foreground="{DynamicResource NavTextBrush}" Opacity="0.55" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="主站功能" FontSize="11" Foreground="{DynamicResource NavTextBrush}" Opacity="0.65" Margin="18,2,0,6" />
                        <RadioButton x:Name="NavMaster" Content="主站调试" Tag="&#xE70F;" TabIndex="0" GroupName="MasterNav"
                                     Style="{StaticResource NavItemStyle}" IsChecked="True" Checked="OnNavChecked" />
                        <RadioButton Content="报文监视器" Tag="&#xE72D;" TabIndex="1" GroupName="MasterNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                        <RadioButton Content="历史趋势" Tag="&#xE7C4;" TabIndex="2" GroupName="MasterNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                        <RadioButton Content="手动命令" Tag="&#xE724;" TabIndex="3" GroupName="MasterNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                        <RadioButton Content="日志查看" Tag="&#xE7C3;" TabIndex="4" GroupName="MasterNav"
                                     Style="{StaticResource NavItemStyle}" Checked="OnNavChecked" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource MainContentBrush}" Padding="10">
                <views:MasterSessionsView x:Name="MasterSessionsControl" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="SessionStatusText" DockPanel.Dock="Left" Text="当前会话：-" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Text, ElementName=VersionText}" FontSize="10"
                           Foreground="{DynamicResource NavTextBrush}" Opacity="0.65" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="PacketStatusText" DockPanel.Dock="Right" Text="报文：0" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RunStatusText" DockPanel.Dock="Right" Text="已停止" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CommConfigText" DockPanel.Dock="Right" Text="离线" FontSize="11"
                           Foreground="{DynamicResource NavTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CommStatusText" Text="通信状态：离线" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource NavTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
